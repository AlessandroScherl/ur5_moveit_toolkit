#!/usr/bin/env python3
"""Switch between MoveIt planning and MoveIt Servo control.

    ros2 run ur5_moveit_toolkit switch_controller trajectory   # MoveIt plans/executes
    ros2 run ur5_moveit_toolkit switch_controller servo        # MoveIt Servo (twist/jog)
    ros2 run ur5_moveit_toolkit switch_controller status
"""
import argparse

import rclpy
from rclpy.executors import SingleThreadedExecutor
from threading import Thread

from ur5_moveit_toolkit import ControllerSwitcher

parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
parser.add_argument("mode", choices=["trajectory", "servo", "status"])
args = parser.parse_args()

rclpy.init()
node = rclpy.create_node("ur5_switch_controller")
executor = SingleThreadedExecutor()
executor.add_node(node)
spin_thread = Thread(target=executor.spin, daemon=True)
spin_thread.start()
switcher = ControllerSwitcher(node)
try:
    if args.mode != "status":
        switcher.switch_to(args.mode)
    print(f"Motion mode: {switcher.active_mode()}")
finally:
    executor.shutdown()
    spin_thread.join()
    node.destroy_node()
    rclpy.shutdown()
