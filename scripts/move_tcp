#!/usr/bin/env python3
"""Move tool0 relative to its current pose (straight line, MoveIt Cartesian planning).

    ros2 run ur5_moveit_toolkit move_tcp --dz -0.05             # 5 cm down (base frame)
    ros2 run ur5_moveit_toolkit move_tcp --dz 0.08 --frame tool # 8 cm along tool Z (approach)
    ros2 run ur5_moveit_toolkit move_tcp --drz 0.5236 --frame tool  # rotate 30 deg about tool Z
"""
import argparse
import sys

from ur5_moveit_toolkit import UR5

parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
for axis in ["dx", "dy", "dz"]:
    parser.add_argument(f"--{axis}", type=float, default=0.0, help="metres")
for axis in ["drx", "dry", "drz"]:
    parser.add_argument(f"--{axis}", type=float, default=0.0, help="radians")
parser.add_argument("--frame", choices=["base", "tool"], default="base")
parser.add_argument("--free", action="store_true", help="allow non-straight path")
parser.add_argument("--speed", type=float, default=0.1)
args = parser.parse_args()

with UR5(node_name="ur5_move_tcp") as robot:
    ok = robot.move_relative(args.dx, args.dy, args.dz, args.drx, args.dry, args.drz,
                             frame=args.frame, cartesian=not args.free,
                             speed=args.speed, accel=args.speed)
    print("done" if ok else "FAILED")
sys.exit(0 if ok else 1)
