#!/usr/bin/env python3
"""Move with a constant velocity via MoveIt Servo (switches to forward_position_controller).

    ros2 run ur5_moveit_toolkit jog --vz 0.02 --time 1.0              # 2 cm/s along tool Z
    ros2 run ur5_moveit_toolkit jog --vx 0.02 --frame base --time 2   # base X
    ros2 run ur5_moveit_toolkit jog --wz 0.2 --time 1                 # rotate about tool Z
    ros2 run ur5_moveit_toolkit jog --vz 0.02 --back                  # switch back to trajectory after
"""
import argparse

from ur5_moveit_toolkit import UR5

parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
for axis in ["vx", "vy", "vz"]:
    parser.add_argument(f"--{axis}", type=float, default=0.0, help="m/s")
for axis in ["wx", "wy", "wz"]:
    parser.add_argument(f"--{axis}", type=float, default=0.0, help="rad/s")
parser.add_argument("--time", type=float, default=1.0, help="seconds")
parser.add_argument("--frame", choices=["tool", "base"], default="tool")
parser.add_argument("--back", action="store_true", help="re-activate trajectory controller at the end")
args = parser.parse_args()

MAX_LIN, MAX_ANG = 0.25, 0.5  # keep student experiments slow
lin = [args.vx, args.vy, args.vz]
ang = [args.wx, args.wy, args.wz]
if max(map(abs, lin)) > MAX_LIN or max(map(abs, ang)) > MAX_ANG:
    parser.error(f"limit: {MAX_LIN} m/s, {MAX_ANG} rad/s (edit the script if you really need more)")

with UR5(node_name="ur5_jog") as robot:
    robot.jog(lin, ang, duration=args.time, frame="tool0" if args.frame == "tool" else "base")
    if args.back:
        robot.use_trajectory_mode()
    print("done")
