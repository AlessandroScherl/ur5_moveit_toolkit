#!/usr/bin/env python3
"""Move to a joint configuration with MoveIt (switches to the trajectory controller).

    ros2 run ur5_moveit_toolkit move_joints home.json
    ros2 run ur5_moveit_toolkit move_joints --deg 0 -90 90 -90 -90 0
    ros2 run ur5_moveit_toolkit move_joints home.json --speed 0.3
"""
import argparse
import json
import sys

import numpy as np

from ur5_moveit_toolkit import UR5

parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
parser.add_argument("file", nargs="?", help="JSON file with 'joint_positions' (rad)")
parser.add_argument("--rad", nargs=6, type=float, metavar="Q")
parser.add_argument("--deg", nargs=6, type=float, metavar="Q")
parser.add_argument("--speed", type=float, default=0.2, help="0..1 velocity scaling (default 0.2)")
args = parser.parse_args()

if args.file:
    with open(args.file) as f:
        target = json.load(f)["joint_positions"]
elif args.rad:
    target = args.rad
elif args.deg:
    target = list(np.radians(args.deg))
else:
    parser.error("give a JSON file, --rad or --deg")

with UR5(node_name="ur5_move_joints") as robot:
    print("target deg:", [round(float(np.degrees(v)), 2) for v in target])
    ok = robot.move_joints(target, speed=args.speed, accel=args.speed)
    print("done" if ok else "FAILED")
sys.exit(0 if ok else 1)
