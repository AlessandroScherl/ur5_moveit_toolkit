#!/usr/bin/env python3
"""Save the current joint angles to a JSON file (teach a pose by hand / freedrive first).

    ros2 run ur5_moveit_toolkit save_joints home.json
"""
import argparse
import json

import numpy as np

from ur5_moveit_toolkit import UR5

parser = argparse.ArgumentParser()
parser.add_argument("file", nargs="?", default="current_joints.json")
args = parser.parse_args()

with UR5(node_name="ur5_save_joints") as robot:
    q = robot.joints()
    with open(args.file, "w") as f:
        json.dump({"joint_positions": q, "tcp_pose": robot.tcp_pose()}, f, indent=2)
    print(f"Saved to {args.file}")
    print("rad:", [round(v, 4) for v in q])
    print("deg:", [round(float(np.degrees(v)), 2) for v in q])
