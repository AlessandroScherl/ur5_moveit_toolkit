#!/usr/bin/env python3
"""Print joint angles, tool0 pose and active controllers.

    ros2 run ur5_moveit_toolkit status
"""
import numpy as np

from ur5_moveit_toolkit import UR5, JOINT_NAMES

with UR5(node_name="ur5_status") as robot:
    q = robot.joints()
    print("Joints:")
    for name, value in zip(JOINT_NAMES, q):
        print(f"  {name:22s} {value:+.4f} rad  {np.degrees(value):+8.2f} deg")
    p = robot.tcp_pose()
    print("tool0 in base  [x y z] m:      " + " ".join(f"{v:+.4f}" for v in p[:3]))
    print("               [rx ry rz] rad: " + " ".join(f"{v:+.4f}" for v in p[3:]))
    states = robot.controllers.states()
    print(f"Motion mode: {robot.controllers.active_mode()}")
    print("Controllers:")
    for name, state in sorted(states.items()):
        print(f"  {name:38s} {state}")
